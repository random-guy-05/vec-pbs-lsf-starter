set -euo pipefail
cd "${LS_SUBCWD:-$PWD}"
seed="${LSB_JOBINDEX:?Expected LSF array index}"
run_dir="runs/${LSB_JOBID:-manual}/${seed}"
mkdir -p "$run_dir"

python -m your_model.train --seed "$seed" --output "$run_dir"
