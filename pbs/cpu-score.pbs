set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"

mkdir -p "runs/${PBS_JOBID:-manual}"
python -m your_model.score --input data/released_input.h5ad --output "runs/${PBS_JOBID:-manual}/scores.json"
