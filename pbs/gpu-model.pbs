#!/usr/bin/env bash
#PBS -N vec-gpu-model
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=08:00:00
#PBS -j oe
# Site-specific only: ask your administrator for the correct PBS GPU resource.
# Do not assume that ngpus, gpus, or another resource name is enabled.

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"

mkdir -p "runs/${PBS_JOBID:-manual}"
python -m your_model.train --device cuda --output "runs/${PBS_JOBID:-manual}"
